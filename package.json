    "lucide-static": "^1.61.0",
    "marked": "^18.1.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.56.1",
    "sass": "^1.106.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "turndown": "^7.2.4"
